{
  "name": "@liem-opc/chat-to-article-mcp-ui",
  "version": "0.1.0",
  "description": "聊出文章来（chat-to-article）的 MCP App：把写作计划、主张、大纲、正文块、插图和风格候选变成嵌在 agent 对话里的审阅界面，支持修订模式编辑与批注。",
  "keywords": [
    "chat-to-article",
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "review",
    "track-changes",
    "writing"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "chat-to-article-mcp-ui": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EldonChen/chat-to-article.git",
    "directory": "packages/mcp-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm run build:views && tsx dev/host.ts",
    "build:views": "vite build --mode review && vite build --mode figure",
    "build": "rm -rf dist && pnpm run build:views && tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2"
  },
  "devDependencies": {
    "@liem-opc/chat-to-article-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.0",
    "@tiptap/core": "^3.4.0",
    "@tiptap/extension-placeholder": "^3.4.0",
    "@tiptap/pm": "^3.4.0",
    "@tiptap/react": "^3.4.0",
    "@tiptap/starter-kit": "^3.4.0",
    "@types/diff": "^7.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "diff": "^8.0.0",
    "lucide-react": "^0.540.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.10.0",
    "prosemirror-markdown": "^1.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.4",
    "zustand": "^5.0.8"
  }
}
