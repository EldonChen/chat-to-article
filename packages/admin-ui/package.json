{
  "name": "@liem-opc/chat-to-article-admin-ui",
  "version": "0.1.0",
  "description": "聊出文章来（chat-to-article）的本地只读管理台：查看声音目录、词表与当前目录下的文章，并导出 Markdown。",
  "keywords": ["chat-to-article", "writing", "agent-skill", "admin", "markdown"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "chat-to-article-admin-ui": "dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EldonChen/chat-to-article.git",
    "directory": "packages/admin-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/cli.ts --no-open --port 4310\" \"vite\"",
    "build": "vite build && tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "fflate": "^0.8.2",
    "hono": "^4.10.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@liem-opc/chat-to-article-core": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.0",
    "lucide-react": "^0.540.0",
    "mermaid": "^11.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.8.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zustand": "^5.0.8"
  }
}
